    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <audio>
      <device>default</device>
    </audio>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>45.0270961</latitude_deg>
      <longitude_deg>14.625763</longitude_deg>
      <elevation>1.5</elevation>
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <state world_name='marina_harmonic_world'>
      <sim_time>1931 367000000</sim_time>
      <real_time>286 834474999</real_time>
      <wall_time>1732270848 804629631</wall_time>
      <iterations>285348</iterations>
      <model name='ground_plane'>
        <pose>50 50 -1 0 -0 0</pose>
        <scale>1 1 1</scale>
        <link name='link'>
          <pose>50 50 -1 0 -0 0</pose>
          <velocity>0 0 0 0 -0 0</velocity>
          <acceleration>0 0 0 0 -0 0</acceleration>
          <wrench>0 0 0 0 -0 0</wrench>
        </link>
      </model>
      <light name='0_sun'>
        <pose>0 50 40 0 -0 0</pose>
      </light>
      <light name='sun_clone'>
        <pose>0 450 40 0 -0 0</pose>
      </light>
    </state>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>181.688 448.672 834.563 0 1.5258 0.024192</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
    
  </world>
</sdf>
