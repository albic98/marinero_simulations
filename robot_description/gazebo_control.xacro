<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"> 

    <gazebo reference="chassis">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="fl_wheel">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
        <kp>1e10</kp>
        <kd>10.0</kd>
        <fdir1>0 0 1</fdir1>
    </gazebo>

    <gazebo reference="fr_wheel">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
        <kp>1e10</kp>
        <kd>10.0</kd>
        <fdir1>0 0 1</fdir1>
    </gazebo>

    <gazebo reference="rl_wheel">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
        <kp>1e10</kp>
        <kd>10.0</kd>
        <fdir1>0 0 1</fdir1>
    </gazebo>

    <gazebo reference="rr_wheel">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
        <kp>1e10</kp>
        <kd>10.0</kd>
        <fdir1>0 0 1</fdir1>
    </gazebo>

    <gazebo reference="fl_axle_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e10</kp>
        <kd>10.0</kd>
    </gazebo>

    <gazebo reference="fr_axle_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e10</kp>
        <kd>10.0</kd>
    </gazebo>

    <gazebo reference="rl_axle_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e10</kp>
        <kd>10.0</kd>
    </gazebo>

    <gazebo reference="rr_axle_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e10</kp>
        <kd>10.0</kd>
    </gazebo>

    <gazebo reference="camera_base">
        <mu1>2.0</mu1>
        <mu2>2.0</mu2>
        <kp>5e10</kp>
        <kd>10.0</kd>
    </gazebo>

    <gazebo reference="left_camera_link"></gazebo>

    <gazebo reference="right_camera_link"></gazebo>

    <gazebo reference="lidar_link"></gazebo>

    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">

            <!-- Number of wheel pairs -->
            <num_wheel_pairs>2</num_wheel_pairs>

            <!-- Front wheels -->
            <left_joint>fl_wheel_joint</left_joint>
            <right_joint>fr_wheel_joint</right_joint>

            <!-- Rear wheels -->
            <left_joint>rl_wheel_joint</left_joint>
            <right_joint>rr_wheel_joint</right_joint>

            <wheel_separation>0.425</wheel_separation>
            <wheel_separation>0.425</wheel_separation>

            <wheel_radius>0.1016</wheel_radius>
            <wheel_radius>0.1016</wheel_radius>

            <!-- limits -->
            <max_wheel_torque>20.0</max_wheel_torque>
            <max_wheel_acceleration>10.0</max_wheel_acceleration>
            <max_linear_acceleration>1.0</max_linear_acceleration>

            <!-- output -->
            <topic>/cmd_vel</topic>
            <odom_topic>/marinero/odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            <odom_publisher_frequency>50</odom_publisher_frequency>
            <tf_topic>/tf</tf_topic>

        </plugin>
    </gazebo>

    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>
            <joint_name>fl_wheel_joint</joint_name>
            <joint_name>fr_wheel_joint</joint_name>
            <joint_name>rl_wheel_joint</joint_name>
            <joint_name>rr_wheel_joint</joint_name>
            <joint_name>camera_base_joint</joint_name>
            <joint_name>left_camera_joint</joint_name>
            <joint_name>right_camera_joint</joint_name>
        </plugin>
    </gazebo>

    <!-- <gazebo>
        <plugin name="gazebo_ros_joint_pose_trajectory" 
            filename="libgazebo_ros_joint_pose_trajectory.so">
            <update_rate>100</update_rate>
        </plugin>
    </gazebo> -->

</robot>