    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">

            <!-- Number of wheel pairs -->
            <num_wheel_pairs>2</num_wheel_pairs>

            <!-- Front wheels -->
            <left_joint>fl_wheel_joint</left_joint>
            <right_joint>fr_wheel_joint</right_joint>

            <!-- Rear wheels -->
            <left_joint>rl_wheel_joint</left_joint>
            <right_joint>rr_wheel_joint</right_joint>

            <wheel_separation>0.425</wheel_separation>
            <wheel_separation>0.425</wheel_separation>

            <wheel_radius>0.1016</wheel_radius>
            <wheel_radius>0.1016</wheel_radius>

            <!-- limits -->
            <max_wheel_torque>50.0</max_wheel_torque>
            <max_wheel_acceleration>5.0</max_wheel_acceleration>
            <max_linear_acceleration>5.0</max_linear_acceleration>

            <!-- input -->
            <topic>cmd_vel_stamped</topic>

            <!-- output -->
            <odom_topic>marinero/odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            <odom_publisher_frequency>100</odom_publisher_frequency>
            <tf_topic>/tf</tf_topic>
        </plugin>
        
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin" >
            <parameters>$(find marinero_simulations)/config/camera_controller.yaml</parameters>
        </plugin>

        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>fl_wheel_joint</joint_name>
            <joint_name>fr_wheel_joint</joint_name>
            <joint_name>rl_wheel_joint</joint_name>
            <joint_name>rr_wheel_joint</joint_name>
            <joint_name>camera_base_joint</joint_name>
            <joint_name>left_camera_joint</joint_name>
            <joint_name>right_camera_joint</joint_name>
        </plugin>
    </gazebo>

    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="camera_base_joint">
            <command_interface name="position">
                <param name="min">-1.57</param>
                <param name="max">1.57</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>

        <joint name="right_camera_joint">
            <command_interface name="position">
                <param name="min">-1.57</param>
                <param name="max">1.57</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">1.6</param>
            </state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>

        <joint name="left_camera_joint">
            <command_interface name="position">
                <param name="min">-1.57</param>
                <param name="max">1.57</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">1.5</param>
            </state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
    </ros2_control>

